# ==============================================================================
# Environment Configuration Example
# Copy this file to .env and configure the image and audio paths as needed.
# ==============================================================================

# Directory path for Childhood / Early Memories photos (must end with a slash or match path format)
VITE_PHOTO_PATH=/images/papa/child/

# Directory path for Railway Journey / Add-on memories photos
VITE_PHOTO_PATH1=/images/papa/Add-ons/

# Directory path for Celebrations & World Travels memories photos
VITE_PHOTO_PATH2=/images/papa/inter/

# Main featured/cover photo path
VITE_PHOTO_MAIN=/images/Main.jpg

# Background / Celebration Music audio file path
VITE_MUSIC_PATH=/audio/music.mp3
